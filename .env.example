# ====== MongoDB Atlas Configuration ======
# Store these securely in Azure DevOps variable group "Mongo-secrets"
# These are injected into AKS via Kubernetes secrets during deployment

# MongoDB Atlas connection string (SRV format)
# Format: mongodb+srv://<USER>:<PASS>@<CLUSTER>.mongodb.net/<DB>?retryWrites=true&w=majority
# All services use the same Atlas cluster; each service connects to its own database
MONGO_URI_USER=
MONGO_URI_PRODUCT=
MONGO_URI_ORDER=
MONGO_URI_PAYMENT=

# MongoDB Atlas API Key (for programmatic access, optional)
# Used by: monitoring, backups, or automation
MONGODB_API_KEY=

# ====== JWT Configuration ======
# JWT secret key for token signing/verification
# Generate using: openssl rand -base64 64
# Store securely in Azure DevOps "Mongo-secrets" variable group as "jwt_key"
JWT_KEY=

# ====== Payment Gateway Keys ======
# Stripe API key for payment processing
STRIPE_KEY=

# PayPal API key for payment processing
PAYPAL_CLIENT_ID=

# ====== Deployment Notes ======
# For local development: set these values here
# For AKS deployment: stored in Azure DevOps variable group (Mongo-secrets)
# Pipeline automatically creates Kubernetes secrets from these variables
# See: MONGODB_ATLAS_SETUP.md for detailed setup instructions
